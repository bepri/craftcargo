[61.9643125, "o", "\u001b[?25l"]
[62.825975, "o", "Namespaced partition 'package/librust-tokio-util+full-dev' is invalid.\u001b[K\r\n"]
[62.826097499999996, "o", "Detailed information: Namespaced partitions are formatted as `<namespace>/<partition>`. Namespaces must only contain lowercase letters and numbers. Partitions must only contain lowercase letters, numbers,hyphens and slashes, and may not begin or end with a hyphen or a slash.\u001b[K\r\n"]
[62.829742499999995, "o", "Recommended resolution: This operation cannot be executed.\u001b[K\r\n"]
[62.82981, "o", "Full execution log: '~/.local/state/debcraft/log/debcraft.log'\u001b[K\r\n"]
[62.82997, "o", "\u001b[?25h"]
[70.6153525, "o", "\u001b[0;32mcraftcargo-demo \u001b[0;36m$ \u001b[0m\u001b[0;90m# (The cargo plugin is still being implemented upstream in debcraft)\u001b[0m\r\n"]
[70.6214075, "o", "\u001b[0;32mcraftcargo-demo \u001b[0;36m$ \u001b[0m\u001b[0;90m# Once landed, it's: craftcargo generate \u2192 debcraft pack \u2192 .deb\u001b[0m\r\n"]
[80.6343575, "o", "\u001b[0;32mcraftcargo-demo \u001b[0;36m$ \u001b[0m\u001b[0;90m# Step 7: Compare \u2014 the traditional debcargo approach generates 100+ files\u001b[0m\r\n"]
[80.63948249999999, "o", "\u001b[0;32mcraftcargo-demo \u001b[0;36m$ \u001b[0m\u001b[1mDEBFULLNAME='Demo User' DEBEMAIL='demo@example.com' debcargo package tokio-util --directory ./output/tokio-util-traditional 2>&1 | tail -5\u001b[0m"]
[80.639555, "o", "\r\n"]
[80.95445249999999, "o", "\u001b[1;38;2;255;165;0m\t \u2022  ./output/tokio-util-traditional/debian/copyright\u001b[0m\r\n\u001b[1;38;2;255;165;0m\u001b[0m\r\n\u001b[1;38;2;255;165;0mTo fix, try combinations of the following: \u001b[0m\r\n\u001b[1;38;2;255;165;0m\t \u2022  Write a config file and use it with --config\u001b[0m\r\n\u001b[1;38;2;255;165;0m\t \u2022  Create an overlay directory and add it to your config file with overlay = \"/path/to/overlay\"\u001b[0m\r\n"]
[88.47609, "o", "\u001b[0;32mcraftcargo-demo \u001b[0;36m$ \u001b[0m\u001b[1mfind ./output/tokio-util-traditional -type f | wc -l\u001b[0m\r\n"]
[88.48708500000001, "o", "112\r\n"]
[88.4984525, "o", "\u001b[0;32mcraftcargo-demo \u001b[0;36m$ \u001b[0m\u001b[0;90m# vs our single debcraft.yaml \u2014 much simpler to review and maintain!\u001b[0m\r\n"]
[98.5052375, "o", "\r\n\u001b[1m\u001b[0;36m\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u001b[0m\r\n\u001b[1m\u001b[0;37m        Demo Complete!\u001b[0m\r\n"]
[98.5053675, "o", "\u001b[1m\u001b[0;36m\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u001b[0m\r\n\r\n\u001b[0;37mcraftcargo turns complex Rust crates into clean debcraft.yaml files\r\nthat are easy to review, version-control, and maintain.\u001b[0m\r\n\r\n\u001b[0;90mGenerated output is in: ./output/tokio-util/\u001b[0m\r\n\r\n"]
