[39.660009599999995, "o", "\u001b[0;32mcraftcargo-demo \u001b[0;36m$ \u001b[0m\u001b[1mcd ./output/tokio-util && debcraft pack 2>&1 || true\u001b[0m\r\n"]
[41.147733599999995, "o", "\u001b[?25l"]
[42.100816800000004, "o", "Namespaced partition 'package/librust-tokio-util+full-dev' is invalid.\u001b[K\r\n"]
[42.1011384, "o", "Detailed information: Namespaced partitions are formatted as `<namespace>/<partition>`. Namespaces must only contain lowercase letters and numbers. Partitions must only contain lowercase letters, numbers,hyphens and slashes, and may not begin or end with a hyphen or a slash.\u001b[K\r\n"]
[42.104510399999995, "o", "Recommended resolution: This operation cannot be executed.\u001b[K\r\n"]
[42.104680800000004, "o", "Full execution log: '~/.local/state/debcraft/log/debcraft.log'\u001b[K\r\n"]
[42.10475039999999, "o", "\u001b[?25h"]
[42.482603999999995, "o", "\u001b[0;32mcraftcargo-demo \u001b[0;36m$ \u001b[0m\u001b[0;90m# (The cargo plugin is still being implemented upstream in debcraft)\u001b[0m\r\n"]
[42.488918399999996, "o", "\u001b[0;32mcraftcargo-demo \u001b[0;36m$ \u001b[0m\u001b[0;90m# Once landed, it's: craftcargo generate \u2192 debcraft pack \u2192 .deb\u001b[0m\r\n"]
[47.3022504, "o", "\u001b[0;32mcraftcargo-demo \u001b[0;36m$ \u001b[0m\u001b[0;90m# Step 7: Compare \u2014 the traditional debcargo approach generates 100+ files\u001b[0m\r\n"]
[52.116019200000004, "o", "\u001b[0;32mcraftcargo-demo \u001b[0;36m$ \u001b[0m\u001b[1mDEBFULLNAME='Demo User' DEBEMAIL='demo@example.com' debcargo package tokio-util --directory ./output/tokio-util-traditional 2>&1 | tail -5\u001b[0m\r\n"]
[52.39579919999999, "o", "\u001b[1;38;2;255;165;0m\t \u2022  ./output/tokio-util-traditional/debian/copyright\u001b[0m\r\n\u001b[1;38;2;255;165;0m\u001b[0m\r\n\u001b[1;38;2;255;165;0mTo fix, try combinations of the following: \u001b[0m\r\n\u001b[1;38;2;255;165;0m\t \u2022  Write a config file and use it with --config\u001b[0m\r\n\u001b[1;38;2;255;165;0m\t \u2022  Create an overlay directory and add it to your config file with overlay = \"/path/to/overlay\"\u001b[0m\r\n"]
[52.4112072, "o", "\u001b[0;32mcraftcargo-demo \u001b[0;36m$ \u001b[0m\u001b[1mfind ./output/tokio-util-traditional -type f | wc -l\u001b[0m\r\n"]
[52.4242224, "o", "112\r\n"]
[52.4384016, "o", "\u001b[0;32mcraftcargo-demo \u001b[0;36m$ \u001b[0m\u001b[0;90m# vs our single debcraft.yaml \u2014 much simpler to review and maintain!\u001b[0m\r\n"]
[59.6453664, "o", "\r\n\u001b[1m\u001b[0;36m\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u001b[0m\r\n\u001b[1m\u001b[0;37m        Demo Complete!\u001b[0m\r\n"]
[59.6455128, "o", "\u001b[1m\u001b[0;36m\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u001b[0m\r\n\r\n\u001b[0;37mcraftcargo turns complex Rust crates into clean debcraft.yaml files\r\nthat are easy to review, version-control, and maintain.\u001b[0m\r\n\r\n"]
[59.645800799999996, "o", "\u001b[0;90mGenerated output is in: ./output/tokio-util/\u001b[0m\r\n\r\n"]
