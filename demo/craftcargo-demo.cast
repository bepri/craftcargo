[73.5466095, "o", "\u001b[0;32mcraftcargo-demo \u001b[0;36m$ \u001b[0m\u001b[0;90m# vs our single debcraft.yaml \u2014 from crate to installed .deb in seconds!\u001b[0m\r\n"]
[78.051594, "o", "\r\n\u001b[1m\u001b[0;36m\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u001b[0m\r\n\u001b[1m\u001b[0;37m        Demo Complete!\u001b[0m\r\n"]
[78.051804, "o", "\u001b[1m\u001b[0;36m\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u001b[0m\r\n\r\n\u001b[0;37mcraftcargo turns Rust crates into installable .deb packages\r\nvia a single, reviewable debcraft.yaml file.\u001b[0m\r\n\r\n\u001b[0;90mGenerated output is in: ./output/bon/\u001b[0m\r\n\r\n"]
