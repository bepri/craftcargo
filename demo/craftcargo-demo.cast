[68.2543365, "o", "\u001b[0;32mcraftcargo-demo \u001b[0;36m$ \u001b[0m\u001b[0;90m# Step 7: Compare \u2014 the traditional debcargo approach generates many more files\u001b[0m\r\n"]
[71.26401299999999, "o", "\u001b[0;32mcraftcargo-demo \u001b[0;36m$ \u001b[0m\u001b[1mDEBFULLNAME='Demo User' DEBEMAIL='demo@example.com' debcargo package bon --directory ./output/bon-traditional 2>&1 | tail -5\u001b[0m\r\n"]
[73.521039, "o", "\u001b[1;38;2;255;165;0m\t \u2022  ./output/bon-traditional/debian/copyright\u001b[0m\r\n\u001b[1;38;2;255;165;0m\u001b[0m\r\n\u001b[1;38;2;255;165;0mTo fix, try combinations of the following: \u001b[0m\r\n\u001b[1;38;2;255;165;0m\t \u2022  Write a config file and use it with --config\u001b[0m\r\n\u001b[1;38;2;255;165;0m\t \u2022  Create an overlay directory and add it to your config file with overlay = \"/path/to/overlay\"\u001b[0m\r\n"]
