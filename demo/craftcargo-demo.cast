{"version": 2, "width": 100, "height": 35, "timestamp": 1778683963, "env": {"SHELL": "/bin/bash", "TERM": "xterm-color"}, "title": "craftcargo: Rust \u2192 Ubuntu Packaging Made Easy"}
[0.0454632, "o", "\u001b[H\u001b[2J"]
[0.0492816, "o", "\r\n\u001b[1m\u001b[0;36m\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u001b[0m\r\n\u001b[1m\u001b[0;37m        craftcargo: Rust \u2192 Ubuntu Packaging Made Easy\u001b[0m\r\n\u001b[1m\u001b[0;36m\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u001b[0m\r\n\r\n\u001b[0;90mThis demo shows how craftcargo generates a complete debcraft.yaml\r\nfrom a Rust crate, ready for Ubuntu package building.\u001b[0m\r\n\r\n"]
[4.8743616, "o", "\u001b[0;32mcraftcargo-demo \u001b[0;36m$ \u001b[0m\u001b[0;90m# Step 1: Let's see what craftcargo can do\u001b[0m\r\n"]
[9.7072872, "o", "\u001b[0;32mcraftcargo-demo \u001b[0;36m$ \u001b[0m\u001b[1mdebcargo --help\u001b[0m\r\n"]
[9.7378536, "o", "Package Rust crates for Debian.\r\n\r\n\u001b[32mUsage:\u001b[0m \u001b[32mdebcargo\u001b[0m \u001b[32m<COMMAND>\u001b[0m\r\n\r\n\u001b[33mCommands:\u001b[0m\r\n  \u001b[32mupdate\u001b[0m               Update the user's default crates.io index, outside of a workspace\r\n  \u001b[32mdeb-src-name\u001b[0m         Print the Debian package name for a crate\r\n  \u001b[32mextract\u001b[0m              Extract only a crate, without any other transformations\r\n  \u001b[32mpackage\u001b[0m              Package a Rust crate for Debian\r\n  \u001b[32mpackage-debcraft\u001b[0m     Package a Rust crate for debcraft (generates debcraft.yaml)\r\n  \u001b[32mbuild-order\u001b[0m          Print the transitive dependencies of a package in topological order\r\n  \u001b[32mdeb-dependencies\u001b[0m     Print the dependencies of a package in d/control format\r\n  \u001b[32mupdate-dependencies\u001b[0m  Update debian/control Build-Depends from workspace Cargo.toml files\r\n  \u001b[32mhelp\u001b[0m                 Print this message or the help of the given subcommand(s)\r\n\r\n\u001b[33mOptions:\u001b[0m\r\n  \u001b[32m-h\u001b[0m, \u001b[32m--help\u001b[0m     Print help\r\n  \u001b[32m-V\u001b[0m, \u001b[32m--version\u001b[0m  Print version\r\n"]
[9.7597056, "o", "\u001b[0;32mcraftcargo-demo \u001b[0;36m$ \u001b[0m\u001b[0;90m# Step 2: Let's package 'tokio-util' \u2014 it has features, multiple deps, and licence complexity\u001b[0m"]
[9.7609824, "o", "\r\n\r\n"]
[9.7724664, "o", "\u001b[0;32mcraftcargo-demo \u001b[0;36m$ \u001b[0m"]
[9.7788048, "o", "\u001b[0;90m# First, what would the Debian source package be called?\u001b[0m\r\n"]
[12.2018376, "o", "\u001b[0;32mcraftcargo-demo \u001b[0;36m$ \u001b[0m\u001b[1mdebcargo deb-src-name tokio-util\u001b[0m\r\n"]
[12.3306816, "o", "tokio-util\r\n"]
[12.371044799999998, "o", "\u001b[0;32mcraftcargo-demo \u001b[0;36m$ \u001b[0m\u001b[0;90m# Step 3: Generate the debcraft.yaml\u001b[0m\r\n"]
[14.793619199999998, "o", "\u001b[0;32mcraftcargo-demo \u001b[0;36m$ \u001b[0m\u001b[1mdebcargo package-debcraft tokio-util --directory ./output/tokio-util\u001b[0m\r\n"]
[14.8561464, "o", "\u001b[1m\u001b[92m    Updating\u001b[0m crates.io index\r\n"]
[15.3681432, "o", "\u001b[0;32mcraftcargo-demo \u001b[0;36m$ \u001b[0m\u001b[0;90m# Step 4: Let's look at what was generated\u001b[0m\r\n"]
[17.8090392, "o", "\u001b[0;32mcraftcargo-demo \u001b[0;36m$ \u001b[0m\u001b[1mls -la ./output/tokio-util/\u001b[0m\r\n"]
